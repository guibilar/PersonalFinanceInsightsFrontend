# Rendered by the nginx image at startup: ${API_UPSTREAM} comes from the environment.

# How the browser really connected. Tailscale terminates HTTPS in front of nginx and says so in
# X-Forwarded-Proto; nginx is published on localhost only, so that proxy is the only way in and its
# header can be trusted. Passed on to the API (the session cookie becomes Secure) and drives HSTS.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Browsers that came in over HTTPS must keep using it. An empty value means nginx sends no header.
map $forwarded_proto $hsts {
    https   "max-age=31536000";
    default "";
}

server {
    listen 5095;
    root /usr/share/nginx/html;
    index index.html;
    # Don't advertise the nginx version.
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Same-origin API: no CORS and no backend address baked into the bundle.
    # ^~ so the static-file rules below never take over an /api/ path.
    location ^~ /api/ {
        # Statements up to the API's 5 MB limit, plus the multipart envelope (nginx's default is 1 MB).
        client_max_body_size 6m;
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Files without a content hash in their name must be revalidated, or updates never reach browsers.
    location ~ ^/(theme\.js|favicon\.ico)$ {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Hashed bundles never change, so browsers can cache them for good.
    location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # SPA routes fall back to index.html, which must always be revalidated.
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
