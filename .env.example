# Copy to .env (never committed).

# Tailscale auth key: admin console -> Settings -> Keys -> Generate auth key (one-off is enough).
# Only used on the first start; afterwards the machine stays logged in (tailscale_state volume).
TS_AUTHKEY=tskey-auth-replace-me

# Machine name in your tailnet; the app is served at https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=finance

# Where nginx sends /api. Default: the finance API, http://personal-finance-api:8080.
# To send all requests through the Hestia host (HestiaBackend), which proxies finance:
# API_UPSTREAM=http://hestia-api:8080
