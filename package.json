{
  "name": "personal-finances-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:hestia": "ng serve --proxy-config proxy.conf.hestia.json",
    "start:finance": "ng serve --proxy-config proxy.conf.finance.json",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "test:ci": "ng test --configuration ci --watch=false --headless",
    "openapi:generate": "openapi-typescript openapi/hestia.json -o src/app/core/models/generated/hestia-api.ts && prettier --write src/app/core/models/generated/hestia-api.ts && python3 scripts/openapi-models-check.py",
    "openapi:update": "curl -fsSL https://raw.githubusercontent.com/guibilar/HestiaBackend/main/docs/openapi/hestia.json -o openapi/hestia.json && npm run openapi:generate",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- src/app/core/models/generated openapi/models-check.ts && tsc -p tsconfig.openapi.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "ng2-charts": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@vitest/browser-playwright": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.39.5",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
